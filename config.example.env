# CEO Agent — example configuration. Copy to `.env` (git-ignored) and edit.
# The engine reads environment variables only; no secrets belong in the repo.

# --- PostgreSQL (where intel_buffer lives) ---
PG_DSN=postgresql://user:password@localhost:5432/ecosystem_central
PG_TABLE=intel_buffer

# --- LLM (OpenAI-compatible /chat/completions) ---
# Ollama:     http://127.0.0.1:11434/v1   (LLM_API_KEY=ollama)
# DeepSeek:   https://api.deepseek.com/v1
# OpenAI:     https://api.openai.com/v1
# KiloCode:   https://api.kilo.ai/api/gateway
# vLLM:       http://host:8000/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=300

# --- Identity / routing ---
AGENT_ID=ceo
LISTEN_CHANNEL=ceo_wakeup
# Comma-separated target_agent values this engine consumes.
INTEL_TARGETS=ceo,all
# Who receives this engine's decisions (target_agent on its output).
DECISION_TARGET=fleet

# --- Heartbeat (optional; ping only, never a model call) ---
HEARTBEAT_SEC=300
A2A_HUB=
A2A_AGENT_ID=ceo

# --- Optional AnythingLLM memory enrichment (off by default) ---
ANYTHING_URL=
ANYTHING_KEY=
ANYTHING_WORKSPACE=

INTEL_BATCH=20
