[Unit]
Description=CEO Agent — event-driven decision engine (LISTEN/NOTIFY)
After=network.target postgresql.service
Wants=network.target

[Service]
Type=simple
# Change User= to whoever runs the agent; %h below resolves to that user's home.
User=successbrian
WorkingDirectory=%h/ceo-agent
EnvironmentFile=%h/ceo-agent/.env
ExecStart=/usr/bin/python3 %h/ceo-agent/ceo_agent.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
